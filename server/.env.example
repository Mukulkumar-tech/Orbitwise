# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty to auto-start an ephemeral in-memory MongoDB.
# Data resets on every restart — fine for local dev, never for production.
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/orbitwise?retryWrites=true&w=majority
MONGODB_URI=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate real secrets:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# bcrypt work factor. 12 is the production target and the floor enforced at boot
# when NODE_ENV=production. Tests override this to 4, because bcryptjs is pure JS
# and ~600ms per hash at cost 12 turns a fast suite into a slow one.
BCRYPT_ROUNDS=12

# SameSite policy for the refresh cookie: lax | strict | none
#   lax  — client and API share a domain (including dev, via the Vite proxy)
#   none — client and API on DIFFERENT domains (e.g. Vercel + Render).
#          Required in that case, and requires HTTPS. With 'lax' the browser
#          silently drops the cookie on the cross-site refresh call and every
#          session dies on reload with no visible error.
COOKIE_SAMESITE=lax

# ─── Storage adapter ─────────────────────────────────────────────────────────
# local | cloudinary
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email adapter ───────────────────────────────────────────────────────────
# console | smtp   (console prints verification/reset links to the terminal)
EMAIL_PROVIDER=console
EMAIL_FROM="Orbitwise <no-reply@orbitwise.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Orbitwise AI adapter ────────────────────────────────────────────────────
# rules | claude   (rules answers from platform data, needs no API key)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
